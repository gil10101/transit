# Copy to .env. Never commit .env.

# --- API keys (all free; NYC, Boston, Toronto, Helsinki need none) ---
# BAY511_API_TOKEN is rate-limited 60 req/hr TOTAL. The two Swiss tokens are one per
# API product (SWISS_OTD_TOKEN=gtfs-rt, SWISS_OTD_SA_TOKEN=gtfs-sa service alerts) and
# CANNOT be re-issued if revoked — keep them only here and in SSM, never elsewhere.
CTA_API_KEY=
WMATA_API_KEY=
BAY511_API_TOKEN=
SWISS_OTD_TOKEN=
SWISS_OTD_SA_TOKEN=
ODPT_CONSUMER_KEY=

# --- Local stack ---
KAFKA_BOOTSTRAP=localhost:19092
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
RAW_BUCKET=raw
LAKE_BUCKET=lakehouse

# --- Dagster postgres (compose-internal) ---
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=dagster
DAGSTER_PG_DB=dagster

# --- Snowflake (Terraform + dbt prod, key-pair auth; key in ~/.snowflake/keys/) ---
SNOWFLAKE_ORGANIZATION_NAME=
SNOWFLAKE_ACCOUNT_NAME=
SNOWFLAKE_USER=TERRAFORM_SVC
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
